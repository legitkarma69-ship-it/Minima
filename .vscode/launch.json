    "version": "0.2.0",
    "configurations": [
        {
            "type": "cppvsdbg",
            "request": "launch",
            "name": "MinimaGUI (Debug)",
            "program": "${workspaceFolder}\\x64\\Debug\\MinimaGUI.exe",
            "cwd": "${workspaceFolder}\\x64\\Debug"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}